<nav-bar title="设备连接" bgColor="#0b2853" titleColor="#fff" bind:onBack="onBack"></nav-bar>
<view class="page-container">
  <!-- 进度条 -->
  <view class="progress-container"></view>

  <!-- 步骤条 -->
  <view class="steps-bar">
    <view class="step-btn {{currentTab==0?'step-btn-active':''}}">第一步</view>
    <view class="step-btn {{currentTab==1?'step-btn-active':''}}">第二步</view>
    <view class="step-btn {{currentTab==2?'step-btn-active':''}}">第三步</view>
  </view>

  <!-- 步骤标题 -->
  <view wx:if="{{currentTab==0}}">
    <view class="wifi-wifi-btn-row">
      <image src="/static/wifi.png" class="bluetooth-icon" />
        WiFi配置
    </view>
  </view>
  <view wx:if="{{currentTab==1}}">
    <view class="wifi-wifi-btn-row">
      <image src="/static/bluetooth.png" class="bluetooth-icon"/>
        蓝牙连接
    </view>
  </view>
  <!-- 内容区 -->
  <scroll-view
    class="content-scroll"
    scroll-y="true"
    refresher-enabled="{{currentTab == 0 || currentTab == 1}}"
    refresher-triggered="{{isRefreshing}}"
    bindrefresherrefresh="onContentRefresh"
    style="height: calc(100vh - 120rpx - 60rpx - 100rpx);"
  >
    <!-- 步骤一：WiFi配置 -->
    <view wx:if="{{currentTab==0}}">
      <view class="refresh-tip">下拉刷新WiFi</view>
      <!-- 已选择WiFi（包括手机已连接WiFi） -->
      <view wx:if="{{wifiSelected}}">
        <view class="wifi-card">
          <view class="wifi-card-header">
            <view class="wifi-name">{{wifiName}}</view>
            <view wx:if="{{is5GConnected}}" class="wifi-5g-badge">5G</view>
          </view>
          <view wx:if="{{is5GConnected}}" class="wifi-5g-tip">
            当前WiFi为5G信号，仅支持2.4G WiFi，请更换WiFi
          </view>
          <view wx:if="{{wifiConfigDisabled}}" class="wifi-5g-tip">
            设备已连接到WiFi"{{wifiName}}"，无需重复配网
          </view>
          <view class="wifi-password-container" wx:if="{{!wifiConfigDisabled}}">
            <input
              class="wifi-password-input"
              type="text"
              placeholder="请输入WiFi密码"
              bindinput="onInputPassword"
              value="{{wifiPassword}}"
              disabled="{{is5GConnected}}"
              password="{{!showPassword}}"
            />
            <view 
              class="password-toggle-icon" 
              bindtap="togglePasswordVisibility"
              wx:if="{{!is5GConnected}}"
            >
              <image 
                src="{{showPassword ? '/static/eye.png' : '/static/eye_slash.png'}}" 
                class="eye-icon"
                mode="aspectFit"
              />
            </view>
          </view>
          <view class="wifi-btn-row">
            <view
              class="wifi-action-btn wifi-action-btn-primary {{activeWifiBtn === 'next' ? 'wifi-action-btn--active-primary' : ''}} {{is5GConnected || wifiConfigDisabled ? 'wifi-action-btn--disabled' : ''}}"
              bindtap="nextStep"
              bindtouchstart="onWifiBtnTouchStart"
              bindtouchend="onWifiBtnTouchEnd"
              bindtouchcancel="onWifiBtnTouchEnd"
              data-btn="next"
            >下一步</view>
            <view
              class="wifi-action-btn change-wifi-btn {{activeWifiBtn === 'change' ? 'wifi-action-btn--active-secondary' : ''}} {{isChangingWifi ? 'wifi-action-btn--loading' : ''}}"
              bindtap="showWifiList"
              bindtouchstart="onWifiBtnTouchStart"
              bindtouchend="onWifiBtnTouchEnd"
              bindtouchcancel="onWifiBtnTouchEnd"
              data-btn="change"
            >{{isChangingWifi ? '加载中...' : '更换WiFi'}}</view>
          </view>
        </view>
      </view>
      <!-- 选择WiFi列表 -->
      <view wx:elif="{{showWifiList}}">
        <view class="wifi-tip">请选择要连接的WiFi</view>
        <view class="wifi-list">
          <block wx:for="{{wifiList}}" wx:key="SSID">
            <view
              class="wifi-item"
              bindtap="selectWifi"
              data-ssid="{{item.SSID}}"
              wx:if="{{item.frequency < 3000}}"
            >
              {{item.SSID}} <text class="wifi-type">2.4G</text>
            </view>
          </block>
          <view wx:if="{{wifiList.length === 0}}" class="wifi-tip">
            未获取到WiFi列表，请确保已打开手机WiFi开关并授权位置信息。
          </view>
        </view>
      </view>
      <!-- 默认显示：正在加载WiFi信息 -->
      <view wx:else>
        <view class="wifi-loading">
          <view class="wifi-loading-text">正在检查WiFi状态...</view>
        </view>
      </view>
    </view>

    <!-- 步骤二：蓝牙连接 -->
    <view wx:if="{{currentTab==1}}">
      <view class="refresh-tip">下拉重新搜索</view>
      
      <!-- 扫描动画区域 -->
      <view class="scanning-section">
        <view class="scanning-animation-container">
          <view class="radar-container">
            <view class="radar-circle radar-circle-1"></view>
            <view class="radar-circle radar-circle-2"></view>
            <view class="radar-circle radar-circle-3"></view>
            <view class="radar-circle radar-circle-4"></view>
            <view class="radar-sweep"></view>
            <view class="radar-center"></view>
          </view>
        </view>
        <view class="scanning-text">正在扫描</view>
        <view class="scanning-tip">请确保设备已连接电源,且已进入配网模式</view>
        <view class="scanning-help-link" bindtap="onHelpLinkTap">设备如何进入配网模式?</view>
      </view>

      <!-- 设备列表区域 -->
      <view class="device-discovery-section">
        <view class="device-section-title">发现的蓝牙设备</view>
        <view class="device-list-container">
          <view wx:if="{{devices.length === 0}}" class="device-search-tip">
            正在搜索蓝牙设备...
          </view>
          <block wx:else>
            <block wx:for="{{devices}}" wx:key="deviceId">
              <view class="device-card-new">
                <view class="device-card-info-new">
                  <view class="device-name-new">{{item.displayName || 'zzZMinga'}}</view>
                  <view class="device-mac-new">设备Mac: {{item.formattedMac || item.deviceId || item.uuid}}</view>
                </view>
                <button 
                  class="connect-btn {{item.isConnected ? 'connect-btn-connected' : ''}}" 
                  bindtap="onCustomSwitchTap" 
                  data-deviceId="{{item.deviceId}}"
                  disabled="{{item.isConnected}}"
                >
                  {{item.isConnected ? '已连接' : '连接'}}
                </button>
              </view>
            </block>
          </block>
        </view>
      </view>
    </view>

    <!-- 步骤三：配网结果 -->
    <view wx:if="{{currentTab==2}}">
      <!-- 配网中状态 -->
      <view wx:if="{{isConfiguring}}">
        <view class="wifi-loading">
          <view class="wifi-loading-text">正在配网中，请稍候...</view>
          <view class="wifi-loading-subtext">设备正在连接WiFi，请保持设备开机状态</view>
          <button class="stop-config-btn" bindtap="stopWifiConfig">停止配网</button>
        </view>
      </view>
      <!-- 配网完成 -->
      <view wx:elif="{{wifiConfigSuccess}}">
        <view class="finish-card">
          <image src="/static/success.png" class="finish-icon" mode="aspectFit" />
          <view class="finish-title">配网成功</view>
          <button type="primary" class="finish-btn" bindtap="finishAndReturn">完成并返回首页</button>
        </view>
      </view>
      <!-- 蓝牙已连接，等待/初始化 -->
      <view wx:else>
        <view class="wifi-loading">
          <view class="wifi-loading-text">正在准备配网...</view>
          <view class="wifi-loading-subtext">设备连接成功，请稍候</view>
        </view>
      </view>
    </view>
  </scroll-view>
 </view>
<!-- WiFi状态弹窗 -->
<view wx:if="{{showWifiModal}}" class="wifi-modal-overlay">
  <view class="wifi-modal">
    <view class="wifi-modal-header">
      <image src="/static/wifi.png" class="wifi-modal-icon" />
      <text class="wifi-modal-title">WiFi提示</text>
    </view>
    <view class="wifi-modal-content">
      <text>{{wifiModalContent}}</text>
    </view>
    <view class="wifi-modal-footer">
      <button class="wifi-modal-btn" bindtap="onWifiModalConfirm">我知道了</button>
    </view>
  </view>
 </view>

<!-- 授权成功说明弹窗（第二步进入后显示） -->
<modal-dialog
  visible="{{guideModalVisible}}"
  title="请操作设备，使其进入配网模式"
  content=""
  videoSrc="{{guideVideoSrc}}"
  videoPoster="{{guideVideoPoster}}"
  videoControls="{{true}}"
  videoAutoplay="{{false}}"
  showCancel="{{false}}"
  showConfirm="{{true}}"
  confirmText="已进入配网模式"
  bind:confirm="onGuideConfirm"
  bind:close="onGuideConfirm"
  customClass="guide-modal-container"
  confirmClass="guide-modal-button"
></modal-dialog>

<!-- 帮助链接弹窗 -->
<modal-dialog
  visible="{{helpModalVisible}}"
  title="设备如何进入配网模式"
  content="请按照以下步骤操作：\n1. 确保设备已连接电源\n2. 点击3次设备上的SOS按钮\n3. 等待设备指示灯闪烁\n4. 设备进入配网模式后即可搜索连接"
  videoSrc="{{guideVideoSrc}}"
  videoPoster="{{guideVideoPoster}}"
  videoControls="{{true}}"
  videoAutoplay="{{false}}"
  showCancel="{{false}}"
  showConfirm="{{true}}"
  confirmText="我知道了"
  bind:confirm="onHelpModalClose"
  bind:close="onHelpModalClose"
  customClass="guide-modal-container"
  confirmClass="guide-modal-button"
></modal-dialog>
