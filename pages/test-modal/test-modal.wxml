<view class="container">
  <view class="header">
    <text class="title">彈窗組件測試</text>
    <text class="subtitle">ModalDialog 組件使用示例</text>
  </view>

  <view class="demo-section">
    <text class="section-title">基礎彈窗</text>
    <button class="demo-btn" bindtap="showBasicModal">顯示基礎彈窗</button>
  </view>

  <view class="demo-section">
    <text class="section-title">圖標彈窗</text>
    <button class="demo-btn" bindtap="showIconModal">顯示圖標彈窗</button>
  </view>

  <view class="demo-section">
    <text class="section-title">視頻彈窗</text>
    <button class="demo-btn" bindtap="showVideoModal">顯示視頻彈窗</button>
  </view>

  <view class="demo-section">
    <text class="section-title">自定義內容彈窗</text>
    <button class="demo-btn" bindtap="showCustomModal">顯示自定義內容彈窗</button>
  </view>

  <view class="demo-section">
    <text class="section-title">警告彈窗</text>
    <button class="demo-btn" bindtap="showWarningModal">顯示警告彈窗</button>
  </view>

  <view class="demo-section">
    <text class="section-title">確認彈窗</text>
    <button class="demo-btn" bindtap="showConfirmModal">顯示確認彈窗</button>
  </view>
</view>

<!-- 基礎彈窗 -->
<modal-dialog
  visible="{{showBasicModal}}"
  title="基礎彈窗"
  content="這是一個基礎的彈窗示例，包含標題、內容和按鈕。"
  bind:confirm="onBasicConfirm"
  bind:cancel="onBasicCancel"
  bind:close="onBasicClose"
></modal-dialog>

<!-- 圖標彈窗 -->
<modal-dialog
  visible="{{showIconModal}}"
  title="操作成功"
  icon="/static/success.png"
  content="您的操作已成功完成！"
  confirm-text="知道了"
  show-cancel="{{false}}"
  bind:confirm="onIconConfirm"
></modal-dialog>

<!-- 視頻彈窗 -->
<modal-dialog
  visible="{{showVideoModal}}"
  title="視頻教程"
  content="請觀看以下視頻教程："
  video-src="{{videoUrl}}"
  video-poster="{{videoPoster}}"
  video-controls="{{true}}"
  video-autoplay="{{false}}"
  bind:confirm="onVideoConfirm"
  bind:cancel="onVideoCancel"
  bind:videoplay="onVideoPlay"
  bind:videopause="onVideoPause"
  bind:videoerror="onVideoError"
></modal-dialog>

<!-- 自定義內容彈窗 -->
<modal-dialog
  visible="{{showCustomModal}}"
  title="自定義內容"
  bind:confirm="onCustomConfirm"
  bind:cancel="onCustomCancel"
>
  <view slot="content" class="custom-content">
    <view class="custom-item">
      <image src="/static/info.png" class="custom-icon"></image>
      <text class="custom-text">這裡是自定義內容區域</text>
    </view>
    <view class="custom-item">
      <image src="/static/question.png" class="custom-icon"></image>
      <text class="custom-text">支持任意WXML結構</text>
    </view>
    <view class="custom-item">
      <image src="/static/warn.png" class="custom-icon"></image>
      <text class="custom-text">可以包含圖片、文字、按鈕等</text>
    </view>
  </view>
</modal-dialog>

<!-- 警告彈窗 -->
<modal-dialog
  visible="{{showWarningModal}}"
  title="警告"
  icon="/static/warn.png"
  content="此操作將刪除所有數據，且無法恢復！"
  confirm-text="確認刪除"
  cancel-text="取消"
  confirm-type="warn"
  bind:confirm="onWarningConfirm"
  bind:cancel="onCustomCancel"
></modal-dialog>

<!-- 確認彈窗 -->
<modal-dialog
  visible="{{showConfirmModal}}"
  title="確認操作"
  icon="/static/question.png"
  content="您確定要執行此操作嗎？"
  confirm-text="確定"
  cancel-text="取消"
  confirm-type="primary"
  bind:confirm="onConfirmConfirm"
  bind:cancel="onConfirmCancel"
></modal-dialog>
