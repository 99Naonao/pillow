/* 页面级别滚动控制 */
page {
  height: 100vh;
  overflow: hidden;
  position: fixed;
  width: 100vw;
}

.container {
  background: linear-gradient(135deg, #0a1a2e 0%, #16213e 50%, #0f3460 100%);
  height: 100vh;
  width: 100vw;
  padding: 0;
  position: fixed;
  top: 0;
  left: 0;
  overflow: hidden;
}

/* 科技感网格背景 */
.container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: 
    linear-gradient(rgba(0, 255, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 255, 255, 0.03) 1px, transparent 1px);
  background-size: 50rpx 50rpx;
  pointer-events: none;
  z-index: 0;
}

/* 动态光效 */
.container::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(0, 255, 255, 0.1) 0%, transparent 70%);
  animation: rotate 20s linear infinite;
  pointer-events: none;
  z-index: 0;
}

@keyframes rotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.top-space {
  height: 20rpx;
}

.pillow-img-wrapper {
  width: 100%;

  padding-top: 60%;
  position: relative;
  margin: 0 auto 32rpx auto;
  background: #083869;
  border-radius: 32rpx;
  
}

.pillow-img {
  position: absol
  ute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
  box-shadow: 
    0 4rpx 24rpx rgba(0,0,0,0.3),
    0 0 40rpx rgba(0, 255, 255, 0.2),
    inset 0 0 60rpx rgba(0, 255, 255, 0.1);
  object-fit: contain;
  background-size: cover;
  background-position: center;
  filter: brightness(1.1) contrast(1.05);
  z-index: 1;
}

.device-bar {
  height: 80rpx;
  display: flex;
  align-items: center;
  border-radius: 60rpx;
  background: linear-gradient(179.41deg, rgba(163, 151, 116, 1) 41.22%, rgba(194, 178, 129, 1) 73.61%, rgba(204, 188, 141, 1) 94.91%);
  margin: 0 24rpx 32rpx 24rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  justify-content: center;
  opacity: 1;
  position: relative;
}

.icon-bluetooth {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
  text-align: center;
  align-self: center;
}

.device-text {
  font-weight: bold;
  text-align: center;
  line-height: 80rpx;
}

.card-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 24rpx;
  position: absolute;
  bottom: 120rpx;
  left: 0;
  right: 0;
  z-index: 1;
}

.device-status-btn {
  width: 100%;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  padding: 16rpx 32rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  opacity: 1;
  border-radius: 16rpx;
  background: rgba(33, 93, 171, 1);
  box-shadow: 0px 6px 10px  rgba(83, 47, 170, 0.2);
}

.device-status-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.device-status-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.device-status-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: bold;
  line-height: 1.2;
}

.device-status-sub-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 400;
  line-height: 1.2;
  margin-top: 4rpx;
}

.card {
  width: calc(50% - 12rpx);
  background: rgba(33, 93, 171, 0.5);
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  position: relative;
  min-height: 240rpx;
  overflow: hidden;
  box-sizing: border-box;
}

/* 心率和呼吸卡片需要更高的高度来容纳折线图 */
.card:nth-child(2),
.card:nth-child(3) {
  min-height: 320rpx;
}


.card-header {
  width: 100%;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  position: relative;
  margin-bottom: 20rpx;
}


.card-icon {
  width: 54rpx;
  height: 54rpx;
  z-index: 2;
}

.card-title {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 400;
  z-index: 2;
}

.card-value {
  position: absolute;
  bottom: 18rpx;
  left: 0;
  right: 0;
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
  text-align: left;
  width: 100%;
  padding: 0 24rpx;
  letter-spacing: 2rpx;
  z-index: 3;
}

.waveform-canvas {
  position: absolute;
  top: 74rpx;
  bottom: 60rpx;
  left: 0;
  right: 0;
  width: 100%; 
  z-index: 2;
  padding: 0 10rpx;
  box-sizing: border-box;
}
