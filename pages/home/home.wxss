/* 页面级别滚动控制 */
page {
  height: 100vh;
  overflow: hidden;
  position: fixed;
  width: 100vw;
}

.container {
  background: linear-gradient(135deg, #0a1a2e 0%, #16213e 50%, #0f3460 100%);
  height: 100vh;
  width: 100vw;
  padding: 0;
  position: fixed;
  top: 0;
  left: 0;
  overflow: hidden;
}

/* 科技感网格背景 */
.container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: 
    linear-gradient(rgba(0, 255, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 255, 255, 0.03) 1px, transparent 1px);
  background-size: 50rpx 50rpx;
  pointer-events: none;
  z-index: 0;
}

/* 动态光效 */
.container::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(0, 255, 255, 0.1) 0%, transparent 70%);
  animation: rotate 20s linear infinite;
  pointer-events: none;
  z-index: 0;
}

@keyframes rotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.top-space {
  height: 20rpx;
}

.pillow-img-wrapper {
  width: 100%;

  padding-top: 60%;
  position: relative;
  margin: 0 auto 32rpx auto;
  background: #083869;
  border-radius: 32rpx;
  
}

.pillow-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
  box-shadow: 
    0 4rpx 24rpx rgba(0,0,0,0.3),
    0 0 40rpx rgba(0, 255, 255, 0.2),
    inset 0 0 60rpx rgba(0, 255, 255, 0.1);
  object-fit: contain;
  background-size: cover;
  background-position: center;
  filter: brightness(1.1) contrast(1.05);
  z-index: 1;
}

.device-bar {
  height: 80rpx;
  display: flex;
  align-items: center;
  border-radius: 60rpx;
  background: linear-gradient(179.41deg, rgba(163, 151, 116, 1) 41.22%, rgba(194, 178, 129, 1) 73.61%, rgba(204, 188, 141, 1) 94.91%);
  margin: 0 24rpx 32rpx 24rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  justify-content: center;
  opacity: 1;
  position: relative;
}

.icon-bluetooth {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
  text-align: center;
  align-self: center;
}

.device-text {
  font-weight: bold;
  text-align: center;
  line-height: 80rpx;
}

.card-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 24rpx;
  position: absolute;
  bottom: 220rpx;
  left: 0;
  right: 0;
  z-index: 1;
}

.card {
  width: 48%;
  background: rgba(23, 92, 119, 0.3);
  backdrop-filter: blur(10rpx);
  border-radius: 30rpx;
  margin-bottom: 32rpx;
  padding: 24rpx 0 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  min-height: 180rpx;
  border: 1rpx solid rgba(0, 255, 255, 0.3);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.4),
    0 0 20rpx rgba(0, 255, 255, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
  overflow: hidden;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.2), transparent);
  transition: left 0.5s ease;
}

.card:active::before {
  left: 100%;
}

/* 心率卡片特殊样式 */
.card:nth-child(1) {
  border-color: rgba(255, 0, 100, 0.4);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.4),
    0 0 20rpx rgba(255, 0, 100, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
}

.card:nth-child(1)::before {
  background: linear-gradient(90deg, transparent, rgba(255, 0, 100, 0.3), transparent);
}

/* 呼吸卡片特殊样式 */
.card:nth-child(2) {
  border-color: rgba(0, 255, 255, 0.4);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.4),
    0 0 20rpx rgba(0, 255, 255, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
}

/* 体动卡片特殊样式 */
.card:nth-child(3) {
  border-color: rgba(255, 200, 0, 0.4);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.4),
    0 0 20rpx rgba(255, 200, 0, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
}

.card:nth-child(3) .card-title {
  color: #ffc800;
  text-shadow: 
    0 0 10rpx rgba(255, 200, 0, 0.8),
    0 0 20rpx rgba(255, 200, 0, 0.4);
}

.card:nth-child(3) .card-icon {
  filter: drop-shadow(0 0 8rpx rgba(255, 200, 0, 0.6));
}

.card:nth-child(3) .card-value {
  color: #ffc800;

}

/* 离枕状态卡片特殊样式 */
.card:nth-child(4) {
  border-color: rgba(100, 150, 255, 0.4);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 0, 0, 0.4),
    0 0 20rpx rgba(100, 150, 255, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
}

.card:nth-child(4) .card-title {
  color: #6496ff;
  text-shadow: 
    0 0 10rpx rgba(100, 150, 255, 0.8),
    0 0 20rpx rgba(100, 150, 255, 0.4);
}

.card:nth-child(4) .card-icon {
  filter: drop-shadow(0 0 8rpx rgba(100, 150, 255, 0.6));
}

.card:nth-child(4) .card-value {
  color: #6496ff;
}


.card-header {
  width: 90%;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  position: absolute;
  top: 24rpx;
  left: 5%;
}

/* 设备状态指示器样式 */
.device-status-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 10;
  pointer-events: auto;
}

.status-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  background: rgba(207, 182, 121, 0.2);
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(0, 255, 255, 0.5);
  box-shadow: 
    0 8rpx 32rpx rgba(0,0,0,0.4),
    0 0 40rpx rgba(0, 255, 255, 0.3),
    inset 0 0 40rpx rgba(0, 255, 255, 0.1);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.status-circle.connected {
  border-color: rgba(0, 255, 0, 0.6);
  box-shadow: 
    0 8rpx 32rpx rgba(0,0,0,0.4),
    0 0 40rpx rgba(0, 255, 0, 0.4),
    inset 0 0 40rpx rgba(0, 255, 0, 0.1);
}

.status-circle.offline {
  border-color: rgba(255, 100, 100, 0.6);
  box-shadow: 
    0 8rpx 32rpx rgba(0,0,0,0.4),
    0 0 40rpx rgba(255, 100, 100, 0.3),
    inset 0 0 40rpx rgba(255, 100, 100, 0.1);
}

.status-circle:active {
  transform: scale(0.95) translate(-50%, -50%);
}

.status-main-text {
  color: #00ffff;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  line-height: 1.2;
  text-shadow: 
  0 0 10rpx rgba(0, 255, 255, 0.8),
  0 0 20rpx rgba(0, 255, 255, 0.4);
  position: relative;
  z-index: 2;
}

.status-sub-text {
  color: rgba(0, 255, 255, 0.8);
  font-size: 24rpx;
  font-weight: bold;
  line-height: 1.2;
  text-shadow: 0 0 8rpx rgba(0, 255, 255, 0.6);
  position: relative;
  z-index: 2;
}

.card-icon {
  width: 44rpx;
  height: 44rpx;
  font-weight: bold;
  color: #fff;
  filter: drop-shadow(0 0 8rpx rgba(0, 255, 255, 0.6));
  z-index: 2;
}

.card-title {
  font-size: 28rpx;
  color: #00ffff;
  font-weight: bold;
  margin-left: 16rpx;
  text-shadow: 
  0 0 10rpx rgba(0, 255, 255, 0.8),
  0 0 20rpx rgba(0, 255, 255, 0.4);
  z-index: 2;
}

/* 心率卡片标题特殊颜色 */
.card:nth-child(1) .card-title {
  color: #ff0064;
  text-shadow: 
    0 0 10rpx rgba(255, 0, 100, 0.8),
    0 0 20rpx rgba(255, 0, 100, 0.4);
}

.card:nth-child(1) .card-icon {
  filter: drop-shadow(0 0 8rpx rgba(255, 0, 100, 0.6));
}

.card-value {
  position: absolute;
  bottom: 24rpx;
  left: 0;
  right: 0;
  font-size: 36rpx;
  font-weight: bold;
  color: #00ffff;
  text-align: center;
  width: 100%;
  letter-spacing: 2rpx;
  z-index: 2;
  animation: pulse 2s ease-in-out infinite;
}

/* 心率卡片数值特殊颜色 */
.card:nth-child(1) .card-value {
  color: #ff0064;
}

.card:nth-child(1) .card-value {
  animation: pulseHeart 2s ease-in-out infinite;
}

.waveform-canvas {
  position: absolute;
  bottom: 60rpx;
  left: 10rpx;
  right: 10rpx;
  height: 80rpx;
  width: calc(100% - 20rpx);
  z-index: 2;
  filter: drop-shadow(0 0 8rpx rgba(0, 255, 255, 0.4));
}

/* 心率波形图特殊光效 */
.card:nth-child(1) .waveform-canvas {
  filter: drop-shadow(0 0 8rpx rgba(255, 0, 100, 0.4));
}