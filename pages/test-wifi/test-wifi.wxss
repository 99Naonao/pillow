/* pages/test-wifi/test-wifi.wxss */
.test-wifi-container {
  background: #f5f5f5;
  min-height: 100vh;
}

/* 步骤指示器 */
.step-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  background: #fff;
  margin-bottom: 20rpx;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.step-number {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #e0e0e0;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  transition: all 0.3s ease;
}

.step-item.active .step-number {
  background: #0b2853;
  color: #fff;
}

.step-text {
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s ease;
}

.step-item.active .step-text {
  color: #0b2853;
  font-weight: 600;
}

.step-line {
  width: 120rpx;
  height: 4rpx;
  background: #e0e0e0;
  margin: 0 20rpx;
  transition: all 0.3s ease;
}

.step-line.active {
  background: #0b2853;
}

/* 步骤内容 */
.step-content {
  padding: 0 32rpx;
}

/* 表单区域 */
.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 40rpx;
  text-align: center;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  background: #fff;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #0b2853;
}

/* Picker样式 */
.picker {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  background: #fff;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.picker:active {
  border-color: #0b2853;
}

.next-btn {
  width: 100%;
  height: 80rpx;
  background: #0b2853;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 20rpx;
}

.next-btn:active {
  background: #1a3a63;
}

/* 蓝牙区域 */
.bluetooth-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 32rpx;
  text-align: center;
}

/* 状态信息 */
.status-info {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.status-text {
  font-size: 28rpx;
  color: #666;
  margin-right: 16rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #e0e0e0;
  border-top: 4rpx solid #0b2853;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 连接状态 */
.connection-status {
  margin-bottom: 32rpx;
}

.status-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.status-item:last-child {
  border-bottom: none;
}

.status-label {
  font-size: 28rpx;
  color: #666;
}

.status-value {
  font-size: 28rpx;
  font-weight: 500;
}

.status-value.connected {
  color: #52c41a;
}

.status-value.disconnected {
  color: #ff4d4f;
}

/* 设备列表 */
.device-list {
  margin-bottom: 32rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  overflow: hidden;
}

.device-list-title {
  font-size: 28rpx;
  color: #666;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  text-align: center;
}

.device-items {
  max-height: 400rpx;
  overflow-y: auto;
}

.device-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background-color 0.2s ease;
}

.device-item:last-child {
  border-bottom: none;
}

.device-item:active {
  background: #f5f5f5;
}

.device-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.device-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.device-id {
  font-size: 24rpx;
  color: #999;
}

.device-arrow {
  font-size: 24rpx;
  color: #ccc;
  margin-left: 16rpx;
}

.no-devices {
  padding: 40rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.action-btn.primary {
  background: #0b2853;
  color: #fff;
}

.action-btn.primary:active {
  background: #1a3a63;
}

.action-btn.secondary {
  background: #f5f5f5;
  color: #666;
  border: 2rpx solid #e0e0e0;
}

.action-btn.secondary:active {
  background: #e8e8e8;
}

.action-btn.danger {
  background: #ff4d4f;
  color: #fff;
}

.action-btn.danger:active {
  background: #d9363e;
}

.action-btn[disabled] {
  opacity: 0.5;
  background: #f5f5f5 !important;
  color: #ccc !important;
}

/* 状态弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #fff;
  border-radius: 16rpx;
  width: 600rpx;
  max-width: 90%;
  overflow: hidden;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  padding: 40rpx 40rpx 20rpx;
  text-align: center;
}

.modal-body {
  font-size: 28rpx;
  color: #666;
  padding: 0 40rpx 40rpx;
  text-align: center;
  line-height: 1.6;
}

.modal-footer {
  border-top: 1rpx solid #f0f0f0;
  padding: 20rpx 40rpx 40rpx;
}

.modal-btn {
  width: 100%;
  height: 80rpx;
  background: #0b2853;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.modal-btn:active {
  background: #1a3a63;
}
