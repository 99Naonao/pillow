<!--pages/test-wifi/test-wifi.wxml-->
<view class="test-wifi-container">
  <nav-bar title="配网测试" showNavBtn="{{true}}" bgColor="#0b2853" titleColor="#fff"/>
  
  <!-- 步骤指示器 -->
  <view class="step-indicator">
    <view class="step-item {{currentStep >= 1 ? 'active' : ''}}">
      <view class="step-number">1</view>
      <text class="step-text">WiFi信息</text>
    </view>
    <view class="step-line {{currentStep >= 2 ? 'active' : ''}}"></view>
    <view class="step-item {{currentStep >= 2 ? 'active' : ''}}">
      <view class="step-number">2</view>
      <text class="step-text">蓝牙配网</text>
    </view>
  </view>

  <!-- 步骤1: WiFi信息填写 -->
  <view wx:if="{{currentStep === 1}}" class="step-content">
    <view class="form-section">
      <view class="form-title">选择WiFi网络</view>
      
      <!-- WiFi选择器 -->
      <view class="form-item">
        <text class="form-label">WiFi名称</text>
        <picker 
          bindchange="onWifiPickerChange" 
          value="{{selectedWifiIndex}}" 
          range="{{wifiList}}"
          disabled="{{!isInitOK || wifiList.length === 0}}"
        >
          <view class="picker">
            {{wifiList.length > 0 ? wifiList[selectedWifiIndex] : '请等待获取WiFi信息...'}}
          </view>
        </picker>
      </view>
      
      <!-- 手动输入WiFi名称 -->
      <view class="form-item">
        <text class="form-label">或手动输入WiFi名称</text>
        <input 
          class="form-input" 
          placeholder="请输入WiFi名称" 
          value="{{wifiName}}"
          bind:input="onWifiNameInput"
          maxlength="32"
        />
      </view>
      
      <view class="form-item">
        <text class="form-label">WiFi密码</text>
        <input 
          class="form-input" 
          placeholder="请输入WiFi密码" 
          value="{{wifiPassword}}"
          bind:input="onPasswordInput"
          password="{{true}}"
          maxlength="64"
        />
      </view>
      
      <button 
        class="next-btn" 
        bindtap="startWifiConfig"
        disabled="{{!isInitOK || !wifiName || !wifiPassword}}"
      >
        {{isInitOK ? '开始配网' : '设备初始化中...'}}
      </button>
    </view>
  </view>

  <!-- 步骤2: 蓝牙连接和配网 -->
  <view wx:if="{{currentStep === 2}}" class="step-content">
    <view class="bluetooth-section">
      <view class="section-title">蓝牙连接与配网</view>
      
      <!-- 状态信息 -->
      <view class="status-info">
        <text class="status-text">{{statusMessage}}</text>
        <view wx:if="{{isConfiguring}}" class="loading-spinner"></view>
      </view>
      
      <!-- 蓝牙连接状态 -->
      <view class="connection-status">
        <view class="status-item">
          <text class="status-label">蓝牙连接:</text>
          <text class="status-value {{isBluetoothConnected ? 'connected' : 'disconnected'}}">
            {{isBluetoothConnected ? '已连接' : '未连接'}}
          </text>
        </view>
        <view wx:if="{{connectedDeviceId}}" class="status-item">
          <text class="status-label">设备ID:</text>
          <text class="status-value">{{connectedDeviceId}}</text>
        </view>
      </view>
      
      <!-- 设备列表 -->
      <view wx:if="{{showDeviceList}}" class="device-list">
        <view class="device-list-title">找到 {{bluetoothDevices.length}} 个GoodSleep设备</view>
        <view class="device-items">
          <view 
            wx:for="{{bluetoothDevices}}" 
            wx:key="deviceId"
            class="device-item"
            data-device-id="{{item.deviceId}}"
            data-device-name="{{item.name}}"
            bindtap="selectBluetoothDevice"
          >
            <view class="device-info">
              <text class="device-name">{{item.name || '未知设备'}}</text>
              <text class="device-id">{{item.deviceId}}</text>
            </view>
            <view class="device-arrow">></view>
          </view>
        </view>
        <view wx:if="{{bluetoothDevices.length === 0}}" class="no-devices">
          <text>未找到GoodSleep设备</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="action-buttons">
        <button 
          class="action-btn primary" 
          bindtap="startBluetoothSearch"
          disabled="{{isConfiguring}}"
        >
          搜索设备
        </button>
        
        <button 
          wx:if="{{isConfiguring}}"
          class="action-btn danger" 
          bindtap="stopWifiConfig"
        >
          停止配网
        </button>
        
        <button 
          class="action-btn secondary" 
          bindtap="restart"
          disabled="{{isConfiguring}}"
        >
          重新开始
        </button>
        
        <button 
          class="action-btn secondary" 
          bindtap="onPrevStep"
          disabled="{{isConfiguring}}"
        >
          上一步
        </button>
      </view>
    </view>
  </view>

  <!-- 状态弹窗 -->
  <view wx:if="{{showStatusModal}}" class="modal-overlay" bindtap="closeStatusModal">
    <view class="modal-content" catchtap="">
      <view class="modal-title">{{statusModalTitle}}</view>
      <view class="modal-body">{{statusModalContent}}</view>
      <view class="modal-footer">
        <button class="modal-btn" bindtap="closeStatusModal">确定</button>
      </view>
    </view>
  </view>
</view>
