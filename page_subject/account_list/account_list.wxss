.account-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0b2853 0%, #061737 100%);
  color: #fff;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page-body {
  padding: 32rpx;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  gap: 24rpx;
}

.timestamp {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.refresh-btn {
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.2);
  margin-right: 0px;
}

.state-card {
  padding: 48rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.state-card.error {
  border-color: rgba(255, 99, 71, 0.4);
}

.state-subtext {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.retry-btn {
  margin-top: 24rpx;
  background: #cfb679;
  color: #0b2853;
}

.account-list {
  display: flex;
  flex-direction: column;
  /* gap: 24rpx; */
}

.account-card {
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
  margin-bottom: 20rpx;
}

.account-header {
  display: flex;
  align-items: center;
  /* justify-content: space-between; */
  gap: 24rpx;
}

.account-avatar {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
}

.account-card:active {
  transform: scale(0.98);
}

.account-main {
  display: flex;
  align-items: center;
  flex: 1;
  gap: 12rpx;
}

.account-name {
  font-size: 32rpx;
  font-weight: 600;
}

.account-role {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);
  color: rgba(255, 255, 255, 0.9);
}

.account-role.owner {
  border-color: #ffd479;
  color: #ffd479;
}

.account-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.account-status {
  font-size: 24rpx;
  margin-left: 18rpx;
}

.account-status.active {
  color: #79ffd8;
}

.account-status.inactive {
  color: #ffbca0;
}

.account-extra {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.account-actions {
	margin-top: 30rpx;
 display: flex;
/* align-items: center;
  gap: 16rpx;
  flex-shrink: 0; */
}

.switch-btn {
  min-width: 120rpx;
  border-radius: 999rpx;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  flex-shrink: 0;
  margin: 0 30rpx 0 auto; 
}

.switch-btn[disabled] {
  opacity: 0.6;
}

.unbind-btn {
  min-width: 120rpx;
  border-radius: 999rpx;
  border: 1px solid rgba(255, 99, 71, 0.4);
  background: rgba(255, 99, 71, 0.15);
  color: #ff6347;
  flex-shrink: 0;
  margin: 0;
}

.unbind-btn[disabled] {
  opacity: 0.6;
}

.unbind-btn:active:not([disabled]) {
  background: rgba(255, 99, 71, 0.25);
}

.tips {
  margin-top: 16rpx;
  text-align: center;
}

.add-account-btn {
background: linear-gradient(135deg, #1a73ff, #5cf1ff);
color: #fff;
  position: fixed;
  bottom: 48rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
  /* background: #cfb679; */
  /* color: #0b2853; */
  border: none;
  /* border-radius: 999rpx; */
  padding: 0 40rpx;
  line-height: 72rpx;
  height: 72rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
  font-weight: 600;
  
  border-radius: 36rpx;
  font-size: 24rpx;
  font-weight: bold;
  width: 80%;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-modal {
  position: fixed;
  inset: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
}

.modal-container {
  position: relative;
  width: 640rpx;
  background: rgba(7, 18, 42, 0.96);
  border-radius: 32rpx;
  padding: 48rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.4);
  z-index: 1;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
}

.modal-close {
  font-size: 48rpx;
  line-height: 1;
  padding: 0 8rpx;
}

.modal-body {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.modal-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.modal-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.modal-input {
  /* width: 100%; */
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #fff;
}

.modal-actions {
  margin-top: 40rpx;
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
}

.modal-btn {
  min-width: 160rpx;
  border-radius: 999rpx;
  border: none;
}

.modal-btn.ghost {
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  
  border-radius: 36rpx;
  font-size: 24rpx;
  font-weight: bold;
  width: 45%;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.solid {
  /* background: #cfb679; */
  background: linear-gradient(135deg, #1a73ff, #5cf1ff);
  color: #fff;
  /* color: #0b2853; */
  font-weight: 600;
  border-radius: 36rpx;
  font-size: 24rpx;
  font-weight: bold;
  width: 45%;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

