.device-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0b2853 0%, #061737 100%);
  color: #fff;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page-body {
  padding: 32rpx;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  gap: 24rpx;
}

.timestamp {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.refresh-btn {
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.2);
  margin-right: 0;
}

.state-card {
  padding: 48rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.state-card.error {
  border-color: rgba(255, 99, 71, 0.4);
}

.state-subtext {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.retry-btn {
  margin-top: 24rpx;
  background: #cfb679;
  color: #0b2853;
}

.device-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.device-card {
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.device-card:active {
  transform: scale(0.98);
}

.device-content {
  /* display: flex; */
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.device-info {
  flex: 1;
}

.device-mac {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.device-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.device-actions {
 display: flex;
 margin-top: 12rpx;
  /* align-items: center; */
  /* gap: 16rpx; */
  /* flex-shrink: 0; */
  
}

.switch-btn {
  min-width: 120rpx;
  border-radius: 999rpx;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.12) !important;
  color: #fff !important;
  /* flex-shrink: 0; */
  margin-right: 20rpx;
}

.switch-btn[disabled] {
  opacity: 0.6;
}

.name-btn {
  min-width: 120rpx;
  border-radius: 999rpx;
  border: 1px solid rgba(207, 182, 121, 0.4);
  background: rgba(207, 182, 121, 0.15);
  color: #cfb679;
  flex-shrink: 0;
  margin-right: 20rpx;
  margin-left: 0;
}

.name-btn[disabled] {
  opacity: 0.6;
}

.name-btn:active:not([disabled]) {
  background: rgba(207, 182, 121, 0.25);
}

.unbind-btn {
  min-width: 120rpx;
  border-radius: 999rpx;
  border: 1px solid rgba(255, 99, 71, 0.4);
  background: rgba(255, 99, 71, 0.15);
  color: #ff6347;
  flex-shrink: 0;
  margin: 0 ;
}

.unbind-btn[disabled] {
  opacity: 0.6;
}

.unbind-btn:active:not([disabled]) {
  background: rgba(255, 99, 71, 0.25);
}

.tips {
  margin-top: 16rpx;
  text-align: center;
}

.load-more {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 设备命名弹窗样式 */
.name-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.name-modal {
  width: 600rpx;
  background: rgba(11, 40, 83, 0.95);
  border-radius: 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
  overflow: hidden;
}

.name-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.name-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.name-modal-close {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1;
  padding: 8rpx;
}

.name-modal-content {
  padding: 32rpx;
}

.name-modal-input {
  width: 100%;
  height: 80rpx;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.08);
  box-sizing: border-box;
}

.name-modal-input::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.name-modal-btns {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx 32rpx 32rpx;
}

.name-modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.name-modal-btn.cancel {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.8);
}

.name-modal-btn.confirm {
  background: #cfb679;
  color: #0b2853;
}

.name-modal-btn.cancel:active {
  background: rgba(255, 255, 255, 0.15);
}

.name-modal-btn.confirm:active {
  background: rgba(207, 182, 121, 0.8);
}

