.device-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0b2853 0%, #061737 100%);
  color: #fff;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page-body {
  padding: 32rpx;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  gap: 24rpx;
}

.timestamp {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.refresh-btn {
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.2);
  margin-right: 0;
}

.state-card {
  padding: 48rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.state-card.error {
  border-color: rgba(255, 99, 71, 0.4);
}

.state-subtext {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.retry-btn {
  margin-top: 24rpx;
  background: #cfb679;
  color: #0b2853;
}

.device-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.device-card {
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.device-card:active {
  transform: scale(0.98);
}

.device-content {
  /* display: flex; */
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.device-info {
  flex: 1;
}

.device-mac {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.device-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.device-actions {
 display: flex;
 margin-top: 12rpx;
  /* align-items: center; */
  /* gap: 16rpx; */
  /* flex-shrink: 0; */
  
}

.switch-btn {
  min-width: 120rpx;
  border-radius: 999rpx;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  /* flex-shrink: 0; */
  margin-right: 20rpx;
}

.switch-btn[disabled] {
  opacity: 0.6;
}

.unbind-btn {
  min-width: 120rpx;
  border-radius: 999rpx;
  border: 1px solid rgba(255, 99, 71, 0.4);
  background: rgba(255, 99, 71, 0.15);
  color: #ff6347;
  flex-shrink: 0;
  margin: 0 ;
}

.unbind-btn[disabled] {
  opacity: 0.6;
}

.unbind-btn:active:not([disabled]) {
  background: rgba(255, 99, 71, 0.25);
}

.tips {
  margin-top: 16rpx;
  text-align: center;
}

.load-more {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

